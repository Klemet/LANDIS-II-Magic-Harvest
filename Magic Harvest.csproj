<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>false</Deterministic>
    <AssemblyVersion>2.2</AssemblyVersion>
    <NeutralLanguage>English</NeutralLanguage>
    <RootNamespace>Landis.Extension.MagicHarvest</RootNamespace>
    <AssemblyName>Landis.Extension.MagicHarvest</AssemblyName>
    <AssemblyTitle>Landis.Extension.MagicHarvest</AssemblyTitle>
    <PackageProjectUrl>http://www.landis-ii.org</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Klemet/LANDIS-II-Magic-Harvest</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>LANDIS-II;Landis;Extension;Harvest</PackageTags>
    <Authors>Clement Hardy</Authors>
    <Description>Magic Harvest Extension</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- NuGet packages (auto-restored by dotnet). Landis.Core brings
         Landis.SpatialModeling and Landis.Utilities transitively. -->
    <PackageReference Include="Landis.Core" Version="3.0.1" />
    <PackageReference Include="log4net" Version="2.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local LANDIS-II extension DLLs in lib/ (fetch via support_libs_download.ps1;
         HintPaths rewritten by the Docker build scripts to build/extensions) -->
    <Reference Include="Landis.Extension.BiomassHarvest-v7">
      <HintPath>lib\Landis.Extension.BiomassHarvest-v7.dll</HintPath>
    </Reference>
    <Reference Include="Landis.Library.HarvestManagement-v5">
      <HintPath>lib\Landis.Library.HarvestManagement-v5.dll</HintPath>
    </Reference>
    <Reference Include="Landis.Library.SiteHarvest-v3">
      <HintPath>lib\Landis.Library.SiteHarvest-v3.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
